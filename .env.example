# Server config read by src/server/env.ts.
# Values can't contain quotes or backslashes.

# PostgreSQL connection string. Migrations run against it at boot.
DATABASE_URL=postgres://glance:secret@localhost:5432/glance

# Where photos are stored: disk (default), s3 or r2.
PHOTO_STORE=disk

# disk: folder for the uploaded photos (kept under DATA_DIR/photos).
DATA_DIR=/var/lib/glance

# s3: an AWS S3 bucket, or any S3-compatible host with S3_ENDPOINT.
# S3_BUCKET=glance-photos
# S3_REGION=us-west-2
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://minio.example.com

# r2: a Cloudflare R2 bucket (R2 → Manage API tokens → Object Read & Write).
# R2_ACCOUNT_ID=
# R2_BUCKET=glance-photos
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Public URL of the screens, exactly as the browser reaches it.
APP_URL=https://glance.example.com

# Sender of sign-in emails: "Name <address>" or a bare address.
# Its domain must be verified with the mail provider.
MAIL_FROM=Glance <glance@example.com>

# Who sends the sign-in emails: resend (default), mailtrap, mailgun or smtp.
MAIL_PROVIDER=resend

# resend: an API key (resend.com → API Keys, "Sending access" is enough).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# mailtrap: an API token (Sending Domains → Integration → API).
# Set MAILTRAP_INBOX_ID to deliver to a sandbox inbox instead.
# MAILTRAP_API_TOKEN=
# MAILTRAP_INBOX_ID=

# mailgun: a sending API key and the sending domain; region us (default) or eu.
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=mg.example.com
# MAILGUN_REGION=us

# smtp: any SMTP server. Port 587 (default) upgrades with STARTTLS when offered;
# set SMTP_SECURE=true for TLS from connect, as on port 465.
# SMTP_USER and SMTP_PASSWORD go together, or leave both out.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
