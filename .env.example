# Server config read by src/server/env.ts. shipit asks for each key on the first deploy (docs/deploy.md).
# Values can't contain quotes or backslashes.

# Folder for the database, photos and nightly backups. With shipit, the app's state folder.
DATA_DIR=/var/lib/glance

# Public URL of the screens, exactly as Caddy serves it. shipit fills it in from the domain.
APP_URL=https://glance.example.com

# Nodemailer SMTP URL for sign-in emails.
SMTP_URL=smtps://user:password@smtp.example.com:465

# Sender of sign-in emails.
MAIL_FROM=Glance <glance@example.com>
