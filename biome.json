{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!docs", "!**/*.md"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noUnknownAtRules": {
          "level": "error",
          "options": {
            "ignore": ["stylex"]
          }
        }
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@/features/*/**"],
                "message": "Import another feature through its index only (tech §3)."
              }
            ]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/theme",
                      "@/theme/**",
                      "**/theme/**",
                      "@/ui",
                      "@/ui/**",
                      "**/ui/**",
                      "@/data",
                      "@/data/**",
                      "**/data/**",
                      "@/shell",
                      "@/shell/**",
                      "**/shell/**",
                      "@/features",
                      "@/features/**",
                      "**/features/**",
                      "@/fixtures",
                      "@/fixtures/**",
                      "**/fixtures/**",
                      "@/server",
                      "@/server/**",
                      "**/server/**",
                      "@/copy",
                      "@/copy/**",
                      "**/copy/**",
                      "react",
                      "react-dom",
                      "next",
                      "next/**",
                      "dexie"
                    ],
                    "message": "domain imports nothing app-specific, Valibot only (tech §3)."
                  },
                  {
                    "group": ["@/features/*/**"],
                    "message": "Import another feature through its index only (tech §3)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/theme/**", "src/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/data",
                      "@/data/**",
                      "**/data/**",
                      "@/shell",
                      "@/shell/**",
                      "**/shell/**",
                      "@/features",
                      "@/features/**",
                      "**/features/**",
                      "@/fixtures",
                      "@/fixtures/**",
                      "**/fixtures/**",
                      "@/server",
                      "@/server/**",
                      "**/server/**",
                      "@/copy",
                      "@/copy/**",
                      "**/copy/**"
                    ],
                    "message": "theme and ui may import only theme and domain (tech §3)."
                  },
                  {
                    "group": ["@/features/*/**"],
                    "message": "Import another feature through its index only (tech §3)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/data/**", "!src/data/**/*.test.ts", "!src/data/**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/theme",
                      "@/theme/**",
                      "**/theme/**",
                      "@/ui",
                      "@/ui/**",
                      "**/ui/**",
                      "@/shell",
                      "@/shell/**",
                      "**/shell/**",
                      "@/features",
                      "@/features/**",
                      "**/features/**",
                      "@/server",
                      "@/server/**",
                      "**/server/**",
                      "@/copy",
                      "@/copy/**",
                      "**/copy/**",
                      "@/fixtures",
                      "@/fixtures/**",
                      "**/fixtures/**"
                    ],
                    "message": "data may import only domain; fixtures only in tests (tech §3)."
                  },
                  {
                    "group": ["@/features/*/**"],
                    "message": "Import another feature through its index only (tech §3)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/data/**/*.test.ts", "src/data/**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/theme",
                      "@/theme/**",
                      "**/theme/**",
                      "@/ui",
                      "@/ui/**",
                      "**/ui/**",
                      "@/shell",
                      "@/shell/**",
                      "**/shell/**",
                      "@/features",
                      "@/features/**",
                      "**/features/**",
                      "@/server",
                      "@/server/**",
                      "**/server/**",
                      "@/copy",
                      "@/copy/**",
                      "**/copy/**"
                    ],
                    "message": "data may import only domain; fixtures only in tests (tech §3)."
                  },
                  {
                    "group": ["@/features/*/**"],
                    "message": "Import another feature through its index only (tech §3)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/fixtures/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/theme",
                      "@/theme/**",
                      "**/theme/**",
                      "@/ui",
                      "@/ui/**",
                      "**/ui/**",
                      "@/data",
                      "@/data/**",
                      "**/data/**",
                      "@/shell",
                      "@/shell/**",
                      "**/shell/**",
                      "@/features",
                      "@/features/**",
                      "**/features/**",
                      "@/server",
                      "@/server/**",
                      "**/server/**",
                      "@/copy",
                      "@/copy/**",
                      "**/copy/**",
                      "react",
                      "react-dom",
                      "next",
                      "next/**",
                      "dexie"
                    ],
                    "message": "fixtures may import only domain (tech §3)."
                  },
                  {
                    "group": ["@/features/*/**"],
                    "message": "Import another feature through its index only (tech §3)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/shell/**", "src/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/server",
                      "@/server/**",
                      "**/server/**",
                      "@/fixtures",
                      "@/fixtures/**",
                      "**/fixtures/**",
                      "@/data/**",
                      "**/data/**",
                      "!@/data/repos",
                      "!@/data/repos/**",
                      "!**/data/repos/**",
                      "dexie"
                    ],
                    "message": "shell and features read data through data/repos hooks only (tech §3, §4.2)."
                  },
                  {
                    "group": ["@/features/*/**"],
                    "message": "Import another feature through its index only (tech §3)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/server/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/theme",
                      "@/theme/**",
                      "**/theme/**",
                      "@/ui",
                      "@/ui/**",
                      "**/ui/**",
                      "@/data",
                      "@/data/**",
                      "**/data/**",
                      "@/shell",
                      "@/shell/**",
                      "**/shell/**",
                      "@/features",
                      "@/features/**",
                      "**/features/**",
                      "@/fixtures",
                      "@/fixtures/**",
                      "**/fixtures/**"
                    ],
                    "message": "server may import only domain and copy (tech §3)."
                  },
                  {
                    "group": ["@/features/*/**"],
                    "message": "Import another feature through its index only (tech §3)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/server/**", "!src/server/db/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/theme",
                      "@/theme/**",
                      "**/theme/**",
                      "@/ui",
                      "@/ui/**",
                      "**/ui/**",
                      "@/data",
                      "@/data/**",
                      "**/data/**",
                      "@/shell",
                      "@/shell/**",
                      "**/shell/**",
                      "@/features",
                      "@/features/**",
                      "**/features/**",
                      "@/fixtures",
                      "@/fixtures/**",
                      "**/fixtures/**"
                    ],
                    "message": "server may import only domain and copy (tech §3)."
                  },
                  {
                    "group": [
                      "@/server/db/postgres",
                      "@/server/db/postgres/**",
                      "**/db/postgres",
                      "**/db/postgres/**"
                    ],
                    "message": "Server code reaches storage only through the server/db port, never an adapter (tech §3, D7)."
                  },
                  {
                    "group": ["@/features/*/**"],
                    "message": "Import another feature through its index only (tech §3)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/app/api/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/theme",
                      "@/theme/**",
                      "**/theme/**",
                      "@/ui",
                      "@/ui/**",
                      "**/ui/**",
                      "@/data",
                      "@/data/**",
                      "**/data/**",
                      "@/shell",
                      "@/shell/**",
                      "**/shell/**",
                      "@/features",
                      "@/features/**",
                      "**/features/**",
                      "@/fixtures",
                      "@/fixtures/**",
                      "**/fixtures/**",
                      "@/server/db",
                      "@/server/db/**"
                    ],
                    "message": "Route handlers import only server services and never touch the database (tech §6.1)."
                  },
                  {
                    "group": ["@/features/*/**"],
                    "message": "Import another feature through its index only (tech §3)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/app/**", "!src/app/api/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/server",
                      "@/server/**",
                      "**/server/**",
                      "@/data",
                      "@/data/**",
                      "**/data/**",
                      "@/fixtures",
                      "@/fixtures/**",
                      "**/fixtures/**"
                    ],
                    "message": "Page files render features and shell only (tech §3)."
                  },
                  {
                    "group": ["@/features/*/**"],
                    "message": "Import another feature through its index only (tech §3)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/app/sw.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/**",
                      "!@/data/sw/**",
                      "**/server/**",
                      "**/data/repos/**",
                      "**/data/sync/**",
                      "dexie",
                      "react",
                      "next",
                      "next/**"
                    ],
                    "message": "The service worker imports serwist and data/sw only (tech §4.5)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
