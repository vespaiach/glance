{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/calendar/**",
              "components/core/**",
              "components/forms/**",
              "components/navigation/**",
              "components/notes/**",
              "components/surfaces/**",
              "components/weather/**",
              "ui_kits/kiosk/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Geist|Geist Mono))/i]",
        "message": "Font not provided by the design system. Available: Geist, Geist Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|body|actionLabel|onAction|tone|style|key|ref|className|style|children)$/]",
        "message": "<Banner> doesn't accept that prop. Declared props: icon, title, body, actionLabel, onAction, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconRight|fullWidth|disabled|children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconRight, fullWidth, disabled, children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|accent|inverse)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'accent' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<Button> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|title|eyebrow|children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, title, eyebrow, children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:hairline|soft|canvas|elevated)$/]",
        "message": "<Card> variant must be one of 'hairline' | 'soft' | 'canvas' | 'elevated'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Clock'] > JSXAttribute > JSXIdentifier[name!=/^(?:time|hour12|showDate|size|align|style|key|ref|className|style|children)$/]",
        "message": "<Clock> doesn't accept that prop. Declared props: time, hour12, showDate, size, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Clock'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xl|lg)$/]",
        "message": "<Clock> size must be one of 'xl' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Clock'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<Clock> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ColorBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|padding|radius|children|style|key|ref|className|style|children)$/]",
        "message": "<ColorBlock> doesn't accept that prop. Declared props: tone, padding, radius, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EventRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:start|end|title|location|status|dot|onClick|style|key|ref|className|style|children)$/]",
        "message": "<EventRow> doesn't accept that prop. Declared props: start, end, title, location, status, dot, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EventRow'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:past|now|upcoming)$/]",
        "message": "<EventRow> status must be one of 'past' | 'now' | 'upcoming'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|color|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:eyebrow|caption)$/]",
        "message": "<Eyebrow> size must be one of 'eyebrow' | 'caption'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ForecastDay'] > JSXAttribute > JSXIdentifier[name!=/^(?:day|icon|high|low|precip|active|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ForecastDay> doesn't accept that prop. Declared props: day, icon, high, low, precip, active, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|variant|size|label|active|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, variant, size, label, active, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:soft|canvas|solid|inverse)$/]",
        "message": "<IconButton> variant must be one of 'soft' | 'canvas' | 'solid' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|touch|lg)$/]",
        "message": "<IconButton> size must be one of 'md' | 'touch' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MonthGrid'] > JSXAttribute > JSXIdentifier[name!=/^(?:year|month|selected|today|marked|onSelect|showTitle|cell|style|key|ref|className|style|children)$/]",
        "message": "<MonthGrid> doesn't accept that prop. Declared props: year, month, selected, today, marked, onSelect, showTitle, cell, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillTabOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<PillTabOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='StickyNote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|author|time|tone|rotate|width|minHeight|onClick|style|key|ref|className|style|children)$/]",
        "message": "<StickyNote> doesn't accept that prop. Declared props: children, author, time, tone, rotate, width, minHeight, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|placeholder|multiline|rows|size|error|style|key|ref|className|style|children)$/]",
        "message": "<TextInput> doesn't accept that prop. Declared props: label, value, onChange, placeholder, multiline, rows, size, error, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextInput'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<TextInput> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Ticker'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|speed|height|style|key|ref|className|style|children)$/]",
        "message": "<Ticker> doesn't accept that prop. Declared props: items, speed, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:brand|center|right|height|inverse|style|key|ref|className|style|children)$/]",
        "message": "<TopBar> doesn't accept that prop. Declared props: brand, center, right, height, inverse, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='WeatherDetail'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|icon|key|ref|className|style|children)$/]",
        "message": "<WeatherDetail> doesn't accept that prop. Declared props: label, value, icon."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
