{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "dev-memory",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DB=memory",
        "APP_URL=http://localhost:3010",
        "npm",
        "run",
        "dev",
        "--",
        "-p",
        "3010"
      ],
      "port": 3010,
      "autoPort": false
    },
    {
      "name": "dev-demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:demo", "--", "-p", "3020"],
      "port": 3020,
      "autoPort": false
    }
  ]
}
